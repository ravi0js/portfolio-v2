---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Impact from '@/components/sections/Impact.astro';
import Experience from '@/components/sections/Experience.astro';
import Systems from '@/components/sections/Systems.astro';
import FeaturedProject from '@/components/sections/FeaturedProject.astro';
import Skills from '@/components/sections/Skills.astro';
import Education from '@/components/sections/Education.astro';
import Contact from '@/components/sections/Contact.astro';
import { site } from '@/lib/content';
const s = site.sections;
---

<BaseLayout path="/">
  <Hero />
  {s.impact.enabled && <Impact />}
  {s.experience.enabled && <Experience />}
  {s.systems.enabled && <Systems />}
  {s.project.enabled && <FeaturedProject />}
  {s.skills.enabled && <Skills />}
  {s.education.enabled && <Education />}
  {s.contact.enabled && <Contact />}
</BaseLayout>
