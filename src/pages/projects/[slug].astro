---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import ArchitectureStack from '@/components/projects/ArchitectureStack.astro';
import EndpointTable from '@/components/ui/EndpointTable.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import Pipeline from '@/components/viz/Pipeline';
import { personalProjects, type PersonalProject } from '@/lib/content';

export const getStaticPaths = (() =>
  personalProjects.map((p) => ({ params: { slug: p.slug }, props: { p } }))) satisfies GetStaticPaths;

const { p } = Astro.props as { p: PersonalProject };
---

<BaseLayout title={p.title} description={p.tagline} path={`/projects/${p.slug}`}>
  <article class="pt-28 pb-24 sm:pt-36">
    <div class="container-page">
      <a href="/#projects" class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg">
        <Icon name="arrowLeft" size={15} /> Back
      </a>

      <header class="mt-8 max-w-3xl" data-reveal>
        <p class="eyebrow mb-3">case study</p>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{p.title}</h1>
        <p class="mt-5 text-pretty text-lg text-muted">{p.overview}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          {p.links.repo && (
            <a href={p.links.repo} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={16} /> Source code
            </a>
          )}
          {p.links.docs && (
            <a href={p.links.docs} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={16} /> Swagger docs
            </a>
          )}
        </div>
        {p.links.docsNote && <p class="mt-3 text-xs text-subtle">{p.links.docsNote}</p>}
      </header>

      <dl class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4" data-reveal>
        {p.stats.map((s) => (
          <div class="card px-4 py-4">
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <p class="font-mono text-3xl font-semibold">{s.value}</p>
              <p class="text-xs text-subtle">{s.label}</p>
            </dd>
          </div>
        ))}
      </dl>

      <div class="mt-14 grid grid-cols-1 gap-12 *:min-w-0 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <div class="space-y-12">
          {p.caseStudy.map((sec) => (
            <section data-reveal>
              <h2 class="text-xl font-semibold tracking-tight">{sec.heading}</h2>
              {sec.body.map((para) => (
                <p class="mt-3 leading-relaxed text-muted">{para}</p>
              ))}
            </section>
          ))}

          <section data-reveal>
            <h2 class="text-xl font-semibold tracking-tight">Architecture</h2>
            <div class="card mt-4 p-4 sm:p-5">
              <ArchitectureStack layers={p.architecture.layers} caption={p.architecture.caption} />
            </div>
          </section>

          <section data-reveal>
            <h2 class="text-xl font-semibold tracking-tight">CI/CD pipeline</h2>
            <div class="card mt-4 p-4 sm:p-5">
              <Pipeline client:visible caption={p.pipeline.caption} stages={p.pipeline.stages} />
            </div>
          </section>

          <section id="endpoints" data-reveal>
            <h2 class="text-xl font-semibold tracking-tight">Endpoints</h2>
            <p class="mt-2 text-sm text-muted">
              All {p.endpoints.length} routes, prefixed with <code class="font-mono text-fg">/api</code>.
            </p>
            <div class="mt-4">
              <EndpointTable endpoints={p.endpoints} />
            </div>
          </section>

          <section data-reveal>
            <h2 class="text-xl font-semibold tracking-tight">Example requests</h2>
            <div class="mt-4 space-y-4">
              {p.examples.map((ex) => (
                <CodeBlock code={ex.code} lang="bash" title={ex.title} />
              ))}
            </div>
          </section>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
          <section class="card p-5">
            <h2 class="font-mono text-xs uppercase tracking-wider text-accent">Roles & access</h2>
            <ul class="mt-4 space-y-4">
              {p.roles.map((r) => (
                <li>
                  <p class="text-sm font-medium">{r.name}</p>
                  <ul class="mt-1 space-y-1">
                    {r.can.map((c) => (
                      <li class="text-xs text-muted">· {c}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
          <section class="card p-5">
            <h2 class="font-mono text-xs uppercase tracking-wider text-accent">Stack</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.stack.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
