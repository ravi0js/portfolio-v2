---
/**
 * Static, always-available JobBoard API documentation.
 * Renders the repo's OpenAPI spec (public/docs/jobboard-api/openapi.json, refreshed
 * with `npm run docs:sync`) in Swagger UI. Read-only: "Try it out" is disabled,
 * because the live API on EC2 runs on a schedule and isn't served over HTTPS.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import { personalProjects } from '@/lib/content';

const p = personalProjects.find((x) => x.slug === 'jobboard-api')!;
const SPEC = '/docs/jobboard-api/openapi.json';
const SWAGGER = 'https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14';
---

<BaseLayout
  title={`${p.title} docs`}
  description={`Interactive OpenAPI documentation for ${p.title}: ${p.endpoints.length} endpoints with Sanctum auth and role-based access.`}
  path="/projects/jobboard-api/docs/"
>
  <link rel="stylesheet" href={`${SWAGGER}/swagger-ui.css`} slot="head" />
  <Container class="pt-28 pb-20 sm:pt-32">
    <a href={`/projects/${p.slug}/`} class="inline-flex items-center gap-2 text-small text-muted hover:text-fg">
      <Icon name="arrowLeft" size={15} /> Back to the case study
    </a>
    <header class="mt-6 max-w-3xl">
      <p class="eyebrow mb-3">api documentation</p>
      <h1 class="text-h1">{p.title}</h1>
      <p class="mt-4 text-pretty text-muted">
        OpenAPI 3.0 reference for all {p.endpoints.length} endpoints. This is a static copy, so it always loads.
        Requests are disabled here; to try the API, run it locally with{' '}
        <code class="font-mono text-small text-fg">docker compose up</code>.
      </p>
      <p class="mt-2 text-small text-muted">
        Source:{' '}
        <a href={p.links.repo} class="text-fg underline underline-offset-2" target="_blank" rel="noopener noreferrer">
          the repository's committed spec
        </a>
      </p>
      <p class="mt-3">
        <a href={SPEC} class="font-mono text-caption text-accent hover:underline">
          Download openapi.json
        </a>
      </p>
    </header>

    <div class="swagger-panel mt-8 overflow-hidden rounded-card border border-line">
      <div id="swagger" aria-label="API reference">
        <p class="p-6 text-small">
          Loading the API reference… If it doesn't appear, <a href={SPEC}>open the raw OpenAPI file</a>.
        </p>
      </div>
    </div>
  </Container>

  <script is:inline src={`${SWAGGER}/swagger-ui-bundle.js`} crossorigin="anonymous" defer></script>
  <script is:inline define:vars={{ SPEC }}>
    window.addEventListener('load', () => {
      if (!window.SwaggerUIBundle) return;
      window.SwaggerUIBundle({
        url: SPEC,
        dom_id: '#swagger',
        deepLinking: true,
        docExpansion: 'list',
        defaultModelsExpandDepth: -1,
        supportedSubmitMethods: [], // read-only: no requests from this page
        tryItOutEnabled: false,
      });
    });
  </script>
</BaseLayout>

<style is:global>
  /* Swagger UI ships a light theme; give it a light panel in both site themes. */
  .swagger-panel {
    background: #fff;
    color: #111;
  }
  .swagger-panel .swagger-ui .info {
    margin: 24px 0;
  }
  .swagger-panel .swagger-ui .scheme-container {
    box-shadow: none;
    border-bottom: 1px solid #e4e4e7;
  }
  .swagger-panel #swagger > p a {
    text-decoration: underline;
  }
</style>
