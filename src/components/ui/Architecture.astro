---
import type { Project } from '@/lib/content';
interface Props {
  architecture: Project['architecture'];
}
const { architecture } = Astro.props;
---

<figure>
  <ol class="space-y-2" aria-label={architecture.caption}>
    {
      architecture.layers.map((layer, i) => (
        <li class="relative">
          <div class="grid gap-2 rounded-[10px] border border-line bg-raised p-3 sm:grid-cols-[7.5rem_1fr] sm:items-center">
            <p class="font-mono text-[0.65rem] uppercase tracking-wider text-accent">{layer.label}</p>
            <ul class="flex flex-wrap gap-2">
              {layer.items.map((item) => (
                <li class="rounded-md border border-line bg-surface px-2.5 py-1 text-xs">{item}</li>
              ))}
            </ul>
          </div>
          {i < architecture.layers.length - 1 && (
            <span class="mx-auto block h-2 w-px bg-line sm:ml-[3.9rem]" aria-hidden="true" />
          )}
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 font-mono text-[0.7rem] text-subtle">{architecture.caption}</figcaption>
</figure>
