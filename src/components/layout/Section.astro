---
import Container from './Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  class?: string;
}
const { id, eyebrow, title, subtitle, class: cls } = Astro.props;
---

<section
  id={id}
  class:list={['py-(--spacing-section) sm:py-(--spacing-section-lg)', cls]}
  aria-labelledby={`${id}-title`}
>
  <Container>
    <SectionHeading id={`${id}-title`} eyebrow={eyebrow} title={title} subtitle={subtitle} class="mb-10 sm:mb-14" />
    <slot />
  </Container>
</section>
