---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  class?: string;
}
const { id, eyebrow, title, subtitle, class: cls } = Astro.props;
---

<section id={id} class:list={['py-20 sm:py-28', cls]} aria-labelledby={`${id}-title`}>
  <div class="container-page">
    <header class="mb-10 max-w-2xl sm:mb-14" data-reveal>
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
      {subtitle && <p class="mt-4 text-pretty text-muted">{subtitle}</p>}
    </header>
    <slot />
  </div>
</section>
