---
import Container from './Container.astro';
import IconButton from '@/components/ui/IconButton.astro';
import { site, profile } from '@/lib/content';
const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line">
  <Container class="flex flex-col gap-4 py-8 text-small text-subtle sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {profile.name}. {site.footer.note}
    </p>
    <div class="flex items-center gap-1">
      {profile.links.map((l) => (
        <IconButton href={l.url} external icon={l.icon} label={l.label} variant="plain" />
      ))}
      <IconButton href={`mailto:${profile.email}`} icon="mail" label="Email" variant="plain" />
    </div>
  </Container>
</footer>
