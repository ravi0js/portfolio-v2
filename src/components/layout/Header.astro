---
import Container from './Container.astro';
import Logo from './Logo.astro';
import Button from '@/components/ui/Button.astro';
import IconButton from '@/components/ui/IconButton.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, profile } from '@/lib/content';

interface Props {
  /** Override nav items (e.g. the design-system preview). Defaults to site.json nav. */
  nav?: { label: string; href: string }[];
}
const { nav = site.nav } = Astro.props;
---

<header
  id="site-header"
  class="no-print fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-base"
>
  <Container class="flex h-16 items-center justify-between gap-4">
    <Logo />

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link relative rounded-md px-3 py-2 text-small text-muted transition-colors duration-fast hover:text-fg aria-[current=true]:text-fg"
              data-nav-link
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {site.theme.allowToggle && (
        <IconButton id="theme-toggle" icon="sun" label="Toggle colour theme">
          <Icon name="sun" size={16} class="hidden [[data-theme='dark']_&]:block" />
          <Icon name="moon" size={16} class="hidden [[data-theme='light']_&]:block" />
        </IconButton>
      )}
      <Button href={profile.cv.file} download icon="download" size="sm" class="hidden sm:inline-flex">
        Resume
      </Button>
      <IconButton
        id="menu-toggle"
        icon="menu"
        label="Open menu"
        class="lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      />
    </div>
  </Container>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 backdrop-blur lg:hidden">
    <Container as="ul" class="flex flex-col py-3">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-md px-3 py-3 text-small text-muted hover:text-fg aria-[current=true]:bg-raised aria-[current=true]:text-fg"
            data-close-menu
            data-nav-link
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <Button href={profile.cv.file} download icon="download" fullWidth>
          {profile.cv.label}
        </Button>
      </li>
    </Container>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('bg-bg/80', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('border-line', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const d = document.documentElement;
    const next = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    d.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: theme still applies for this visit */
    }
  });

  const menuBtn = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenu = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
  menu.querySelectorAll('[data-close-menu]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
      setMenu(false);
      menuBtn.focus();
    }
  });

  // Highlight the nav link for the section in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const targets = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => {
            if (a.hash === `#${e.target.id}`) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  /* Active-section indicator: a short accent underline that grows in. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 1.5px;
    border-radius: 999px;
    background: var(--c-accent);
    transform: scaleX(0);
    transition: transform var(--duration-base) var(--ease-out-soft);
  }
  .nav-link[aria-current='true']::after {
    transform: scaleX(1);
  }
</style>
