---
import Icon from '@/components/ui/Icon.astro';
import { site, profile } from '@/lib/content';
---

<header
  id="site-header"
  class="no-print fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${profile.name}, home`}>
      <span
        class="grid size-8 place-items-center rounded-lg border border-line bg-surface font-mono text-xs font-semibold text-accent transition-colors group-hover:border-accent"
      >
        {profile.initials}
      </span>
      <span class="hidden text-sm font-medium sm:inline">{profile.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {
        site.theme.allowToggle && (
          <button
            id="theme-toggle"
            type="button"
            class="grid size-9 place-items-center rounded-lg border border-line bg-surface text-muted transition-colors hover:text-fg"
            aria-label="Toggle colour theme"
          >
            <Icon name="sun" size={16} class="hidden [[data-theme='dark']_&]:block" />
            <Icon name="moon" size={16} class="hidden [[data-theme='light']_&]:block" />
          </button>
        )
      }
      <a href={profile.cv.file} class="btn btn-primary hidden !py-2 sm:inline-flex" download>
        <Icon name="download" size={15} />
        CV
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-lg border border-line bg-surface text-muted md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={16} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 backdrop-blur md:hidden">
    <ul class="container-page flex flex-col py-3">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} class="block rounded-md px-2 py-3 text-sm text-muted hover:text-fg" data-close-menu>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a href={profile.cv.file} class="btn btn-primary w-full" download>
          <Icon name="download" size={15} />
          {profile.cv.label}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('bg-bg/80', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('border-line', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const d = document.documentElement;
    const next = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    d.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: theme still applies for this visit */
    }
  });

  const menuBtn = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenu = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
  menu.querySelectorAll('[data-close-menu]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>
