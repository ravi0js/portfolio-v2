---
import Section from '@/components/layout/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import Architecture from '@/components/ui/Architecture.astro';
import EndpointTable from '@/components/ui/EndpointTable.astro';
import Pipeline from '@/components/viz/Pipeline';
import { site, featuredProject as p } from '@/lib/content';
const meta = site.sections.project;
---

{p && (
  <Section id="projects" eyebrow={meta.eyebrow} title={meta.title} subtitle={meta.subtitle}>
    <div class="card overflow-hidden" data-reveal>
      <div class="grid gap-8 p-5 sm:p-7 lg:grid-cols-2 lg:gap-10">
        <div>
          <p class="text-pretty text-muted">{p.tagline}</p>

          <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {p.stats.map((s) => (
              <div class="rounded-[10px] border border-line bg-raised px-3 py-3">
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <p class="font-mono text-2xl font-semibold">{s.value}</p>
                  <p class="text-xs text-subtle">{s.label}</p>
                </dd>
              </div>
            ))}
          </dl>

          <ul class="mt-6 space-y-2.5">
            {p.highlights.map((h) => (
              <li class="flex gap-3 text-sm leading-relaxed">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-accent" />
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <div class="mt-7 flex flex-wrap gap-3">
            <a href={`/projects/${p.slug}`} class="btn btn-primary">
              Read the case study
              <Icon name="arrowRight" size={16} />
            </a>
            {p.links.repo && (
              <a href={p.links.repo} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                <Icon name="github" size={16} />
                Source
              </a>
            )}
            {p.links.docs && (
              <a href={p.links.docs} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                <Icon name="external" size={16} />
                API docs
              </a>
            )}
          </div>
          {p.links.docsNote && <p class="mt-3 text-xs text-subtle">{p.links.docsNote}</p>}
        </div>

        <div class="rounded-[12px] border border-line bg-bg/60 p-4 sm:p-5">
          <Architecture architecture={p.architecture} />
        </div>
      </div>

      <div class="border-t border-line p-5 sm:p-7">
        <Pipeline client:visible caption={p.pipeline.caption} stages={p.pipeline.stages} />
      </div>

      <div class="border-t border-line p-5 sm:p-7">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h3 class="font-mono text-xs uppercase tracking-wider text-subtle">Endpoints (sample)</h3>
          <a href={`/projects/${p.slug}#endpoints`} class="text-xs text-accent hover:underline">
            All {p.endpoints.length} →
          </a>
        </div>
        <EndpointTable endpoints={p.endpoints} limit={6} />
      </div>

      <ul class="flex flex-wrap gap-2 border-t border-line p-5 sm:px-7" aria-label="Technologies">
        {p.stack.map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    </div>
  </Section>
)}
