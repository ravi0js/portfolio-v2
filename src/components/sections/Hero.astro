---
import Container from '@/components/layout/Container.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import RequestFlow from '@/components/hero/RequestFlow.astro';
import { profile } from '@/lib/content';
---

<section id="home" class="relative overflow-hidden pt-28 pb-4 sm:pt-36 sm:pb-6" aria-labelledby="hero-title">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px]" aria-hidden="true"></div>

  <Container class="grid grid-cols-1 items-center gap-12 *:min-w-0 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-hero>
        {profile.availability && <Badge dot>{profile.availability}</Badge>}
        <span class="flex items-center gap-1.5 text-caption text-subtle">
          <Icon name="mapPin" size={13} />
          {profile.location}
        </span>
      </div>

      <p class="eyebrow mt-8" data-hero style="--reveal-delay:60ms">
        {profile.name} · {profile.role}
      </p>
      <h1 id="hero-title" class="mt-3 text-display text-balance" data-hero style="--reveal-delay:120ms">
        {profile.headline}
      </h1>
      <p class="mt-6 max-w-xl text-lead text-pretty text-muted" data-hero style="--reveal-delay:180ms">
        {profile.intro}
      </p>

      <ul class="mt-7 flex flex-wrap gap-2" aria-label="Core technologies" data-hero style="--reveal-delay:220ms">
        {profile.heroStack.map((t) => (
          <Badge as="li">{t}</Badge>
        ))}
      </ul>

      <div class="mt-9 flex flex-wrap gap-3" data-hero style="--reveal-delay:260ms">
        <Button href="#projects" iconRight="arrowRight">
          View My Work
        </Button>
        <Button href="#contact" variant="secondary" icon="mail">
          Contact Me
        </Button>
        <Button href={profile.cv.file} variant="secondary" icon="download" download>
          {profile.cv.label}
        </Button>
      </div>
    </div>

    <div data-hero style="--reveal-delay:200ms">
      <RequestFlow />
    </div>
  </Container>
</section>
