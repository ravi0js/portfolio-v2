---
import { site, metrics, about } from '@/lib/content';
const meta = site.sections.impact;

// Don't repeat numbers already shown in the About highlights.
// A strip of one looks unfinished, so render only when 2+ metrics remain.
const shownInAbout = new Set(about.highlights.map((h) => h.metric).filter(Boolean));
const items = metrics.filter((m) => !shownInAbout.has(m.id));
const cols =
  { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4' }[Math.min(items.length, 4)] ?? 'lg:grid-cols-4';
---

{items.length >= 2 && (
  <section aria-label={meta.title} class="border-y border-line bg-surface/50">
    <div class="container-page">
      <h2 class="sr-only">{meta.title}</h2>
      <dl class:list={['grid grid-cols-2 divide-line lg:divide-x', cols]}>
        {items.map((m, i) => (
          <div class="px-1 py-8 sm:px-6 lg:py-10" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <dt class="sr-only">{m.label}</dt>
            <dd>
              <p class="font-mono text-4xl font-semibold tracking-tight sm:text-5xl">
                {m.prefix}
                <span data-count={m.value}>{m.value}</span>
                <span class="text-accent">{m.suffix}</span>
              </p>
              <p class="mt-2 text-sm font-medium">{m.label}</p>
              <p class="mt-1 text-xs text-subtle">{m.context}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<script>
  // Count up numbers once when visible (skipped when reduced motion is on).
  if (document.documentElement.classList.contains('js-motion') && 'IntersectionObserver' in window) {
    const nodes = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          const target = Number(el.dataset.count);
          if (!Number.isFinite(target)) continue;
          const start = performance.now();
          const dur = 1100;
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / dur);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.5 },
    );
    nodes.forEach((n) => io.observe(n));
  }
</script>
