---
import Section from '@/components/layout/Section.astro';
import Card from '@/components/ui/Card.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, profile, about, metrics, experience } from '@/lib/content';

const meta = site.sections.about;
const current = experience.find((e) => e.end === null);
const previous = experience.filter((e) => e.end !== null)[0];

// Quick facts are derived from existing data rather than repeated in about.json.
const facts = [
  current && { label: 'Current', value: `${current.role}, ${current.company}` },
  { label: 'Based in', value: profile.location },
  { label: 'Focus', value: about.focus },
  previous && { label: 'Previously', value: `${previous.role}, ${previous.company}` },
].filter((f): f is { label: string; value: string } => Boolean(f));

const highlights = about.highlights.map((h) => ({
  ...h,
  metricValue: h.metric ? metrics.find((m) => m.id === h.metric) : undefined,
}));
---

<Section id="about" eyebrow={meta.eyebrow} title={meta.title} subtitle={meta.subtitle}>
  <div class="grid grid-cols-1 gap-10 *:min-w-0 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
    <!-- Introduction + quick facts -->
    <div data-reveal>
      <div class="space-y-4 text-lead text-pretty text-muted">
        {about.intro.map((p, i) => (
          <p class:list={[i === 0 && 'text-fg']}>{p}</p>
        ))}
      </div>

      <dl class="mt-8 divide-y divide-line border-y border-line">
        {facts.map((f) => (
          <div class="grid grid-cols-[7rem_1fr] gap-4 py-3 text-small">
            <dt class="font-mono text-caption tracking-label text-subtle uppercase">{f.label}</dt>
            <dd class="text-fg">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Highlights -->
    <div>
      <h3 class="sr-only">{about.highlightsTitle}</h3>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {highlights.map((h, i) => (
          <Card
            as="li"
            interactive
            padding="sm"
            class="group flex flex-col"
            data-reveal
            style={`--reveal-delay:${(i % 2) * 70}ms`}
          >
            <div class="flex items-start justify-between gap-3">
              {h.metricValue ? (
                <p class="font-mono text-h2 leading-none font-semibold tracking-tight">
                  {h.metricValue.prefix}
                  {h.metricValue.value}
                  <span class="text-accent">{h.metricValue.suffix}</span>
                </p>
              ) : (
                <p class="pt-1 font-mono text-small font-medium text-accent">{h.label}</p>
              )}
              <span class="grid size-8 shrink-0 place-items-center rounded-md border border-line bg-raised text-subtle transition-colors duration-base group-hover:text-accent">
                <Icon name={h.icon} size={15} />
              </span>
            </div>
            <p class="mt-4 text-small font-medium">{h.title}</p>
            <p class="mt-1 text-caption leading-relaxed text-muted">{h.detail}</p>
          </Card>
        ))}
      </ul>
    </div>
  </div>

  <!-- Engineering approach -->
  <div class="mt-16 sm:mt-20">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1" data-reveal>
      <h3 class="text-h3">{about.approachTitle}</h3>
      {about.approachSubtitle && <p class="text-small text-subtle">{about.approachSubtitle}</p>}
    </div>
    <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {about.principles.map((p, i) => (
        <li
          class="group bg-surface p-5 transition-colors duration-base hover:bg-raised sm:p-6"
          data-reveal
          style={`--reveal-delay:${(i % 3) * 70}ms`}
        >
          <div class="flex items-center gap-3">
            <span class="grid size-8 place-items-center rounded-md border border-line bg-bg text-accent">
              <Icon name={p.icon} size={15} />
            </span>
            <span class="font-mono text-caption text-subtle">{String(i + 1).padStart(2, '0')}</span>
            {p.scope && (
              <span class="ml-auto rounded-sm border border-line px-1.5 py-0.5 font-mono text-micro text-muted">
                {p.scope}
              </span>
            )}
          </div>
          <h4 class="mt-4 text-small font-semibold">{p.title}</h4>
          <p class="mt-1.5 text-small leading-relaxed text-muted">{p.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</Section>
