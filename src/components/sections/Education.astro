---
import Section from '@/components/layout/Section.astro';
import { site, education } from '@/lib/content';
const meta = site.sections.education;
---

<Section id="education" eyebrow={meta.eyebrow} title={meta.title} subtitle={meta.subtitle} class="!pt-0">
  <ul class="grid gap-4 md:grid-cols-2">
    {
      education.map((e, i) => (
        <li class="card p-5 sm:p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <p class="font-mono text-xs text-subtle">{e.year}</p>
          <h3 class="mt-2 font-semibold">{e.degree}</h3>
          <p class="mt-1 text-sm text-muted">{e.institution}</p>
          {e.score && <p class="mt-3 font-mono text-sm text-accent">{e.score}</p>}
        </li>
      ))
    }
  </ul>
</Section>
