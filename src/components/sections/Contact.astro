---
/**
 * Contact: channels (email, phone on request, location, GitHub, LinkedIn, resume)
 * and a message form. All details come from profile.json; the phone number is
 * never in the page. Submission behaviour lives in src/scripts/contact-forms.ts.
 */
import Section from '@/components/layout/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactCard from '@/components/contact/ContactCard.astro';
import { site, profile } from '@/lib/content';

const meta = site.sections.contact;
const { phoneGate, contactForm } = profile;
const github = profile.links.find((l) => l.icon === 'github');
const linkedin = profile.links.find((l) => l.icon === 'linkedin');
// Show the profile handle (last path segment); the full URL is the link target.
const handle = (url: string) => new URL(url).pathname.replace(/\/$/, '').split('/').pop() ?? url;
const cvName = profile.cv.file.split('/').pop();
---

<Section id="contact" eyebrow={meta.eyebrow} title={meta.title} subtitle={meta.subtitle}>
  <div class="grid grid-cols-1 gap-8 *:min-w-0 lg:grid-cols-[1fr_1.15fr] lg:gap-10">
    <!-- Channels -->
    <div class="space-y-3" data-reveal>
      <ContactCard
        icon="mail"
        label="Email"
        value={profile.email}
        href={`mailto:${profile.email}`}
        ariaLabel={`Email ${profile.email}`}
      />

      {phoneGate.enabled && (
        <div class="card p-4" id="phone-gate">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-md border border-line bg-raised text-accent">
              <Icon name="phone" size={18} />
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-micro tracking-label text-subtle uppercase">Phone</p>
              <p class="mt-0.5 text-small font-medium" data-phone-display>
                <span class="font-mono tracking-widest text-muted">+91 ••••• •••••</span>
                <span class="sr-only">(hidden until requested)</span>
              </p>
            </div>
            <button
              type="button"
              class="btn btn-ghost !px-3 !py-2 text-caption max-sm:w-full"
              data-phone-open
              aria-expanded="false"
              aria-controls="phone-form"
            >
              {phoneGate.buttonLabel}
            </button>
          </div>

          <form
            id="phone-form"
            class="mt-4 hidden space-y-3 border-t border-line pt-4"
            data-endpoint={phoneGate.endpoint}
            novalidate
          >
            <p class="text-caption text-muted">{phoneGate.description}</p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="pg-name" class="mb-1 block text-caption text-muted">
                  Your name <span aria-hidden="true">*</span>
                </label>
                <input
                  id="pg-name"
                  class="input"
                  name="name"
                  autocomplete="name"
                  maxlength="100"
                  required
                  data-validate="name"
                  aria-describedby="pg-name-error"
                />
                <p id="pg-name-error" class="field-error" hidden />
              </div>
              <div>
                <label for="pg-email" class="mb-1 block text-caption text-muted">
                  Your email <span aria-hidden="true">*</span>
                </label>
                <input
                  id="pg-email"
                  class="input"
                  name="email"
                  type="email"
                  autocomplete="email"
                  maxlength="200"
                  required
                  data-validate="email"
                  aria-describedby="pg-email-error"
                />
                <p id="pg-email-error" class="field-error" hidden />
              </div>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="pg-company" class="mb-1 block text-caption text-muted">
                  Company (optional)
                </label>
                <input id="pg-company" class="input" name="company" autocomplete="organization" maxlength="120" />
              </div>
              <div>
                <label for="pg-reason" class="mb-1 block text-caption text-muted">
                  Reason (optional)
                </label>
                <input id="pg-reason" class="input" name="reason" maxlength="300" />
              </div>
            </div>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div data-status class="form-status" hidden>
              <Icon name="alert" size={16} class="status-icon-error shrink-0" />
              <Icon name="checkCircle" size={16} class="status-icon-ok shrink-0" />
              <p data-status-text />
            </div>
            <button type="submit" class="btn btn-primary submit-btn">
              <span class="spinner" aria-hidden="true" />
              <span class="label-idle">Show number</span>
              <span class="label-busy">Sending…</span>
            </button>
          </form>
        </div>
      )}

      <ContactCard icon="mapPin" label="Location" value={profile.location} />

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {github && (
          <ContactCard
            icon="github"
            label="GitHub"
            value={handle(github.url)}
            href={github.url}
            external
            ariaLabel="GitHub profile (opens in a new tab)"
          />
        )}
        {linkedin && (
          <ContactCard
            icon="linkedin"
            label="LinkedIn"
            value={handle(linkedin.url)}
            href={linkedin.url}
            external
            ariaLabel="LinkedIn profile (opens in a new tab)"
          />
        )}
      </div>

      <ContactCard
        icon="download"
        label="Resume"
        value={`${profile.cv.label} (PDF)`}
        href={profile.cv.file}
        download
        ariaLabel={`${profile.cv.label}: ${cvName}`}
      />
    </div>

    <!-- Message form -->
    {contactForm.enabled && (
      <form
        id="contact-form"
        class="card space-y-4 p-5 sm:p-7"
        data-endpoint={contactForm.endpoint}
        data-fallback-email={profile.email}
        novalidate
        aria-labelledby="contact-form-title"
        data-reveal
        style="--reveal-delay:100ms"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h3 id="contact-form-title" class="text-h3">
            Send a message
          </h3>
          <p class="text-caption text-subtle">
            <span aria-hidden="true">*</span> required
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="cf-name" class="mb-1 block text-caption text-muted">
              Name <span aria-hidden="true">*</span>
            </label>
            <input
              id="cf-name"
              class="input"
              name="name"
              autocomplete="name"
              maxlength="100"
              required
              data-validate="name"
              aria-describedby="cf-name-error"
            />
            <p id="cf-name-error" class="field-error" hidden />
          </div>
          <div>
            <label for="cf-email" class="mb-1 block text-caption text-muted">
              Email <span aria-hidden="true">*</span>
            </label>
            <input
              id="cf-email"
              class="input"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="200"
              required
              data-validate="email"
              aria-describedby="cf-email-error"
            />
            <p id="cf-email-error" class="field-error" hidden />
          </div>
        </div>

        <div>
          <label for="cf-subject" class="mb-1 block text-caption text-muted">
            Subject <span aria-hidden="true">*</span>
          </label>
          <input
            id="cf-subject"
            class="input"
            name="subject"
            maxlength="150"
            required
            data-validate="subject"
            aria-describedby="cf-subject-error"
          />
          <p id="cf-subject-error" class="field-error" hidden />
        </div>

        <div>
          <div class="mb-1 flex items-baseline justify-between gap-3">
            <label for="cf-message" class="block text-caption text-muted">
              Message <span aria-hidden="true">*</span>
            </label>
            <span class="font-mono text-micro text-subtle" data-counter aria-hidden="true">
              0 / 3000
            </span>
          </div>
          <textarea
            id="cf-message"
            class="input min-h-40 resize-y"
            name="message"
            maxlength="3000"
            required
            data-validate="message"
            aria-describedby="cf-message-error"
          />
          <p id="cf-message-error" class="field-error" hidden />
        </div>

        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div data-status class="form-status" hidden>
          <Icon name="alert" size={16} class="status-icon-error shrink-0" />
          <Icon name="checkCircle" size={16} class="status-icon-ok shrink-0" />
          <p data-status-text />
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <button type="submit" class="btn btn-primary submit-btn">
            <span class="spinner" aria-hidden="true" />
            <span class="label-idle inline-flex items-center gap-2">
              <Icon name="send" size={15} /> Send message
            </span>
            <span class="label-busy">Sending…</span>
          </button>
          <p class="text-caption text-subtle">
            Or email{' '}
            <a class="text-fg underline-offset-2 hover:underline" href={`mailto:${profile.email}`}>
              {profile.email}
            </a>
          </p>
        </div>
      </form>
    )}
  </div>
</Section>

<style>
  .field-error {
    margin-top: 0.375rem;
    font-size: var(--text-caption);
    color: rgb(251 113 133); /* rose-400 */
  }
  :global([data-theme='light']) .field-error {
    color: rgb(225 29 72); /* rose-600 for contrast on white */
  }
  :global(.input[aria-invalid='true']) {
    border-color: rgb(244 63 94 / 0.7);
  }
  .form-status {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    padding: 0.75rem 0.875rem;
    font-size: var(--text-small);
  }
  .form-status[hidden] {
    display: none;
  }
  .form-status[data-tone='ok'] {
    border-color: color-mix(in oklab, var(--c-accent) 45%, transparent);
    background: color-mix(in oklab, var(--c-accent) 8%, transparent);
  }
  .form-status[data-tone='error'] {
    border-color: rgb(244 63 94 / 0.45);
    background: rgb(244 63 94 / 0.08);
  }
  .form-status[data-tone='ok'] :global(.status-icon-error),
  .form-status[data-tone='error'] :global(.status-icon-ok) {
    display: none;
  }
  .form-status[data-tone='ok'] :global(.status-icon-ok) {
    color: var(--c-accent);
    margin-top: 0.15rem;
  }
  .form-status[data-tone='error'] :global(.status-icon-error) {
    color: rgb(251 113 133);
    margin-top: 0.15rem;
  }
  .form-status :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Submit button states */
  .submit-btn .spinner,
  .submit-btn .label-busy {
    display: none;
  }
  .submit-btn[data-busy='true'] .spinner {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    animation: spin 0.7s linear infinite;
  }
  .submit-btn[data-busy='true'] .label-busy {
    display: inline;
  }
  .submit-btn[data-busy='true'] .label-idle {
    display: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import {
    validateForm,
    liveValidate,
    submitForm,
    showStatus,
    setBusy,
    setFieldError,
    escapeHtml,
  } from '@/scripts/contact-forms';

  const unavailable = (email: string) =>
    `The contact form isn't connected yet, so your message was <strong>not</strong> sent. Please email me directly at <a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a>.`;

  // ── Message form ─────────────────────────────────────────────
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const fallback = form.dataset.fallbackEmail ?? '';
    const message = form.querySelector<HTMLTextAreaElement>('#cf-message')!;
    const counter = form.querySelector<HTMLElement>('[data-counter]')!;
    const updateCount = () => (counter.textContent = `${message.value.length} / ${message.maxLength}`);
    message.addEventListener('input', updateCount);
    updateCount();
    liveValidate(form);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.dataset.attempted = 'true';
      showStatus(form, null);
      if (!validateForm(form)) return;

      setBusy(form, true);
      const result = await submitForm(form, { type: 'message' });
      setBusy(form, false);

      if (result.kind === 'ok') {
        form.reset();
        updateCount();
        delete form.dataset.attempted;
        form.querySelectorAll<HTMLInputElement>('[aria-invalid]').forEach((f) => f.removeAttribute('aria-invalid'));
        showStatus(form, 'ok', "Thanks, your message was sent. I'll reply by email.");
      } else if (result.kind === 'error') {
        const field = result.field && form.querySelector<HTMLInputElement>(`[name="${result.field}"]`);
        if (field) {
          setFieldError(field, result.message);
          field.focus();
        }
        showStatus(form, 'error', `${escapeHtml(result.message)} Your message was not sent.`);
      } else {
        showStatus(form, 'error', unavailable(fallback));
      }
    });
  }

  // ── Phone request ────────────────────────────────────────────
  const gate = document.getElementById('phone-gate');
  if (gate) {
    const openBtn = gate.querySelector<HTMLButtonElement>('[data-phone-open]')!;
    const pform = gate.querySelector<HTMLFormElement>('#phone-form')!;
    const display = gate.querySelector<HTMLElement>('[data-phone-display]')!;
    const fallback = document.getElementById('contact-form')?.dataset.fallbackEmail ?? '';
    liveValidate(pform);

    openBtn.addEventListener('click', () => {
      const open = pform.classList.toggle('hidden') === false;
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) pform.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });

    pform.addEventListener('submit', async (e) => {
      e.preventDefault();
      pform.dataset.attempted = 'true';
      showStatus(pform, null);
      if (!validateForm(pform)) return;

      setBusy(pform, true);
      const result = await submitForm(pform, { type: 'phone_request' });
      setBusy(pform, false);

      if (result.kind === 'ok' && typeof result.data.phone === 'string') {
        const phone = result.data.phone;
        const a = document.createElement('a');
        a.href = `tel:${phone.replace(/[^\d+]/g, '')}`;
        a.className = 'font-mono text-accent hover:underline';
        a.textContent = phone;
        display.replaceChildren(a);
        pform.classList.add('hidden');
        openBtn.remove();
        a.focus();
      } else if (result.kind === 'error') {
        showStatus(pform, 'error', escapeHtml(result.message));
      } else {
        showStatus(
          pform,
          'error',
          `Phone requests aren't connected yet. Please email me at <a href="mailto:${escapeHtml(fallback)}">${escapeHtml(fallback)}</a>.`,
        );
      }
    });
  }
</script>
