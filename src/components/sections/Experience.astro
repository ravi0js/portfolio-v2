---
/**
 * Professional Experience: a vertical timeline. The primary role gets the large,
 * categorised card; other roles use compact cards. All content from experience.json.
 */
import Section from '@/components/layout/Section.astro';
import PrimaryRole from '@/components/experience/PrimaryRole.astro';
import CompactRole from '@/components/experience/CompactRole.astro';
import { site, experience } from '@/lib/content';

const meta = site.sections.experience;
---

<Section id="experience" eyebrow={meta.eyebrow} title={meta.title} subtitle={meta.subtitle}>
  <ol class="timeline relative space-y-8 sm:space-y-10" aria-label="Work history, most recent first">
    {experience.map((job, i) => (
      <li class="relative pl-8 sm:pl-12" data-reveal style={`--reveal-delay:${Math.min(i, 2) * 60}ms`}>
        <span
          class:list={[
            'timeline-dot absolute top-7 left-0 grid size-[17px] place-items-center rounded-full border-2 bg-bg',
            job.end === null ? 'border-accent' : 'border-line',
          ]}
          aria-hidden="true"
        >
          {job.end === null && <span class="size-1.5 rounded-full bg-accent" />}
        </span>
        {job.variant === 'primary' ? <PrimaryRole job={job} /> : <CompactRole job={job} />}
      </li>
    ))}
  </ol>
</Section>

<style>
  /* Vertical rail through the timeline dots. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 2rem;
    bottom: 2rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--c-accent), var(--c-border) 30%, var(--c-border));
  }
</style>
