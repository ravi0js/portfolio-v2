---
import Section from '@/components/layout/Section.astro';
import { site, experience } from '@/lib/content';
import { formatRange, durationLabel } from '@/lib/format';
const meta = site.sections.experience;
---

<Section id="experience" eyebrow={meta.eyebrow} title={meta.title} subtitle={meta.subtitle}>
  <ol class="relative space-y-6 before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-px before:bg-line md:before:left-[calc(12rem+7px)]">
    {
      experience.map((job, i) => (
        <li class="relative grid gap-3 pl-8 md:grid-cols-[12rem_1fr] md:gap-8 md:pl-0" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <span
            class:list={[
              'absolute top-2 left-0 size-[15px] rounded-full border-2 md:left-[12rem]',
              job.end === null ? 'border-accent bg-accent/30' : 'border-line bg-bg',
            ]}
            aria-hidden="true"
          />
          <div class="md:pt-1 md:pr-6 md:text-right">
            <p class="font-mono text-xs text-muted">{formatRange(job.start, job.end)}</p>
            <p class="mt-1 font-mono text-xs text-subtle">{durationLabel(job.start, job.end)}</p>
          </div>
          <article class="card card-hover p-5 sm:p-6 md:ml-8">
            <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-lg font-semibold">
                {job.role} <span class="text-muted">· {job.company}</span>
              </h3>
              <p class="text-xs text-subtle">{job.location}</p>
            </header>
            <p class="mt-2 text-sm text-muted">{job.summary}</p>
            <ul class="mt-4 space-y-2.5">
              {job.highlights.map((h) => (
                <li class="flex gap-3 text-sm leading-relaxed">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span class="text-fg/90">{h}</span>
                </li>
              ))}
            </ul>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
              {job.tags.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
