---
/**
 * Layered architecture diagram: top-to-bottom layers joined by arrows.
 * Used for both the personal project and the (conceptual) professional case study.
 */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  layers: { label: string; items: string[] }[];
  caption: string;
  /** Shown as a small label above the diagram, e.g. "Conceptual". */
  note?: string;
}
const { layers, caption, note } = Astro.props;
---

<figure class="arch">
  {note && (
    <p class="mb-3 inline-flex items-center gap-1.5 rounded-sm border border-line px-2 py-0.5 font-mono text-micro tracking-label text-subtle uppercase">
      <Icon name="layers" size={11} />
      {note}
    </p>
  )}
  <ol class="space-y-0" aria-label={caption}>
    {layers.map((layer, i) => (
      <li>
        <div class="arch-layer grid gap-2 rounded-md border border-line bg-raised p-3 transition-colors duration-base hover:border-accent/50 sm:grid-cols-[8.5rem_1fr] sm:items-center">
          <p class="flex items-center gap-2 font-mono text-micro tracking-label text-accent uppercase">
            <span class="grid size-5 place-items-center rounded-sm bg-accent/10 text-[0.6rem]">{i + 1}</span>
            {layer.label}
          </p>
          <ul class="flex flex-wrap gap-1.5">
            {layer.items.map((item) => (
              <li class="rounded-sm border border-line bg-surface px-2 py-0.5 text-caption">{item}</li>
            ))}
          </ul>
        </div>
        {i < layers.length - 1 && (
          <span class="flex h-5 items-center pl-5 text-subtle" aria-hidden="true">
            <svg width="10" height="20" viewBox="0 0 10 20" fill="none" stroke="currentColor" stroke-width="1.25">
              <path d="M5 1v16M1.5 13.5 5 17l3.5-3.5" />
            </svg>
          </span>
        )}
      </li>
    ))}
  </ol>
  <figcaption class="mt-3 font-mono text-micro text-subtle">{caption}</figcaption>
</figure>
