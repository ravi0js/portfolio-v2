---
/**
 * Primary personal project card: overview, stats, feature groups, architecture,
 * CI/CD pipeline and an expandable API surface. Links only from projects.json.
 */
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import EndpointTable from '@/components/ui/EndpointTable.astro';
import ArchitectureStack from './ArchitectureStack.astro';
import Pipeline from '@/components/viz/Pipeline';
import type { PersonalProject } from '@/lib/content';

interface Props {
  project: PersonalProject;
}
const { project: p } = Astro.props;
---

<Card as="article" padding="none" class="overflow-hidden" data-project={p.slug}>
  <!-- Header -->
  <div class="grid-bg-soft border-b border-line p-5 sm:p-8">
    <div class="flex flex-wrap items-center gap-2">
      <Badge variant="accent">
        <Icon name="code" size={12} />
        {p.label}
      </Badge>
      <span class="font-mono text-caption text-subtle">{p.stack.slice(0, 3).join(' · ')}</span>
    </div>
    <h3 class="mt-4 font-display text-h2">{p.title}</h3>
    <p class="mt-3 max-w-3xl text-lead text-pretty text-muted">{p.overview}</p>

    <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {p.stats.map((s) => (
        <div class="rounded-md border border-line bg-bg/60 px-4 py-3">
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <p class="font-mono text-h3 font-semibold">{s.value}</p>
            <p class="text-caption text-subtle">{s.label}</p>
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <Button href={`/projects/${p.slug}`} iconRight="arrowRight">
        Full case study
      </Button>
      {p.links.repo && (
        <Button href={p.links.repo} variant="secondary" icon="github" external>
          GitHub repository
        </Button>
      )}
      {p.links.docs && (
        <Button href={p.links.docs} variant="secondary" icon="external" external={p.links.docs.startsWith('http')}>
          API documentation
        </Button>
      )}
    </div>
    {p.links.docsNote && <p class="mt-3 text-caption text-subtle">{p.links.docsNote}</p>}
  </div>

  <!-- Features + architecture -->
  <div class="grid grid-cols-1 gap-8 p-5 *:min-w-0 sm:p-8 lg:grid-cols-[1.1fr_1fr] lg:gap-10">
    <div>
      <h4 class="eyebrow mb-4">Key features</h4>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {p.featureGroups.map((g) => (
          <section class="rounded-md border border-line bg-raised p-4" aria-label={g.title}>
            <p class="flex items-center gap-2 text-small font-semibold">
              <Icon name={g.icon} size={15} class="text-accent" />
              {g.title}
            </p>
            <ul class="mt-3 space-y-1.5">
              {g.items.map((item) => (
                <li class="flex gap-2 text-caption leading-relaxed text-muted">
                  <Icon name="check" size={13} class="mt-0.5 shrink-0 text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
    <div>
      <h4 class="eyebrow mb-4">Architecture</h4>
      <ArchitectureStack layers={p.architecture.layers} caption={p.architecture.caption} />
    </div>
  </div>

  <!-- CI/CD -->
  <div class="border-t border-line p-5 sm:p-8">
    <h4 class="eyebrow mb-4">Testing & deployment</h4>
    <Pipeline client:visible caption={p.pipeline.caption} stages={p.pipeline.stages} />
  </div>

  <!-- API surface (expandable) -->
  <details class="group border-t border-line">
    <summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 select-none hover:bg-raised/50 sm:px-8 [&::-webkit-details-marker]:hidden">
      <Icon name="server" size={16} class="text-accent" />
      <span class="flex-1 text-small font-semibold">
        API surface
        <span class="ml-2 font-mono text-caption font-normal text-subtle">
          {p.endpoints.length} endpoints · {p.roles.length - 1} roles + public
        </span>
      </span>
      <Icon name="chevronDown" size={16} class="text-subtle transition-transform duration-base group-open:rotate-180" />
    </summary>
    <div class="grid grid-cols-1 gap-6 px-5 pb-6 *:min-w-0 sm:px-8 lg:grid-cols-[1fr_16rem]">
      <EndpointTable endpoints={p.endpoints} />
      <ul class="space-y-3">
        {p.roles.map((r) => (
          <li class="rounded-md border border-line bg-raised p-3">
            <p class="text-small font-medium">{r.name}</p>
            <ul class="mt-1 space-y-0.5">
              {r.can.map((c) => (
                <li class="text-caption text-muted">· {c}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </details>

  <ul class="flex flex-wrap gap-1.5 border-t border-line px-5 py-4 sm:px-8" aria-label="Technologies">
    {p.stack.map((t) => (
      <Badge as="li" class="!text-micro">
        {t}
      </Badge>
    ))}
  </ul>
</Card>
