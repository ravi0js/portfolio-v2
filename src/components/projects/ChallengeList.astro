---
/** Engineering challenges → approaches, each tagged with the project it comes from. */
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { challenges, projects } from '@/lib/content';

interface Props {
  title?: string;
}
const { title = 'Engineering challenges & solutions' } = Astro.props;
const label = (slug: string) => {
  const p = projects.find((x) => x.slug === slug)!;
  return p.kind === 'personal' ? p.title : 'CRM/ERP (work)';
};
---

<section aria-labelledby="challenges-title">
  <h3 id="challenges-title" class="text-h3" data-reveal>
    {title}
  </h3>
  <div class="mt-6 overflow-hidden rounded-card border border-line" data-reveal>
    <div
      class="hidden grid-cols-[13rem_1fr_9rem] gap-6 border-b border-line bg-raised px-5 py-2.5 font-mono text-micro tracking-label text-subtle uppercase md:grid"
      aria-hidden="true"
    >
      <span>Challenge</span>
      <span>Technical approach</span>
      <span class="text-right">From</span>
    </div>
    <ul class="divide-y divide-line">
      {challenges.map((c) => (
        <li class="grid grid-cols-1 gap-2 bg-surface px-5 py-4 transition-colors duration-fast hover:bg-raised md:grid-cols-[13rem_1fr_9rem] md:gap-6">
          <p class="flex items-start gap-2 text-small font-semibold">
            <Icon name="activity" size={14} class="mt-0.5 shrink-0 text-accent" />
            {c.challenge}
          </p>
          <div>
            <p class="text-small">{c.approach}</p>
            <p class="mt-1 text-caption leading-relaxed text-muted">{c.detail}</p>
          </div>
          <ul class="flex flex-wrap items-start gap-1.5 md:justify-end" aria-label="From">
            {c.projects.map((slug) => (
              <Badge as="li" variant="outline" class="!text-micro">
                {label(slug)}
              </Badge>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
