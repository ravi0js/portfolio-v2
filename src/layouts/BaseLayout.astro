---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/lib/content';
import { personJsonLd, absoluteUrl } from '@/lib/seo';
import { pageTitle } from '@/lib/format';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  bare?: boolean;
}

const { title, description = site.seo.description, path = Astro.url.pathname, bare = false } = Astro.props;
const { theme, seo } = site;
const fullTitle = pageTitle(seo.titleTemplate, title, seo.title);
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(seo.ogImage);

const palette = (p: typeof theme.dark) => `
  --c-bg:${p.bg};--c-surface:${p.surface};--c-surface-raised:${p.surfaceRaised};
  --c-border:${p.border};--c-text:${p.text};--c-muted:${p.muted};--c-subtle:${p.subtle};
  color-scheme:${p === theme.dark ? 'dark' : 'light'};
  ${p.accent ? `--c-accent:${p.accent};` : ''}${p.accentContrast ? `--c-accent-contrast:${p.accentContrast};` : ''}`;

const themeCss = `
:root{--c-accent:${theme.accent};--c-accent-contrast:${theme.accentContrast};
--f-sans:${theme.fonts.sans};--f-mono:${theme.fonts.mono};--r-card:${theme.radius};}
:root,[data-theme='dark']{${palette(theme.dark)}}
[data-theme='light']{${palette(theme.light)}}`;

const boot = { mode: theme.defaultMode, toggle: theme.allowToggle, motion: theme.motion };
---

<!doctype html>
<html lang="en" data-theme={theme.defaultMode === 'light' ? 'light' : 'dark'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={theme.dark.bg} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <style is:inline set:html={themeCss} />
    <script is:inline define:vars={{ boot }}>
      (function () {
        var d = document.documentElement;
        var stored = null;
        try { stored = boot.toggle ? localStorage.getItem('theme') : null; } catch (e) {}
        var mode = stored || boot.mode;
        if (mode === 'system') mode = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.setAttribute('data-theme', mode);
        if (boot.motion && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('js-motion');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd())} />
  </head>
  <body class="min-h-dvh antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] btn btn-primary">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <script>
      // Scroll reveal for [data-reveal] elements.
      const root = document.documentElement;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!root.classList.contains('js-motion') || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
